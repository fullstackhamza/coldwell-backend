# Get this from MongoDB Atlas: Database > Connect > Drivers > copy the
# connection string, then swap in your database user's password.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb://localhost:27017

MONGODB_DB_NAME=coldwell

# Change this to a long random string before deploying anywhere real.
JWT_SECRET=dev-secret-change-me

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# This API's own public URL. Only used for local-disk image URLs — safe
# to leave as-is unless you're testing local-disk uploads.
PUBLIC_BASE_URL=http://localhost:8000

# Cloudinary — leave all three blank for local development (uploads save
# to ./uploads/ and are served from PUBLIC_BASE_URL instead). Fill these
# in for production so photos survive redeploys — see README "Going live"
# section for how to get them (free, no card required).
CLOUDINARY_CLOUD_NAME=qatknerf
CLOUDINARY_API_KEY=275517951825353
CLOUDINARY_API_SECRET=U_M9GdI2NKr974XWAyBsiBMiPak